{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${DESIGNSYSTEMET_PYTHON:-python3} ${CLAUDE_PLUGIN_ROOT}/hooks/guard-ds-code.py --twins ${DESIGNSYSTEMET_TWINS:-${CLAUDE_PLUGIN_ROOT}/registry}"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*designsystemet-twins.*",
        "hooks": [
          {
            "type": "command",
            "command": "${DESIGNSYSTEMET_PYTHON:-python3} ${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-log.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${DESIGNSYSTEMET_PYTHON:-python3} ${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-consent.py"
          }
        ]
      }
    ]
  }
}
